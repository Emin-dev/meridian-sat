# Copy to .env.local. Use an isolated Supabase project and synthetic records.
# Never commit real credentials or use production student records in tests.
NEXT_PUBLIC_SUPABASE_URL=https://your-isolated-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Recommended independent random secret; falls back to ADMIN_PASSWORD if absent.
STUDENT_TOKEN_SECRET=

# Optional AI/media integrations. Synthetic tests do not call these services.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
YOUTUBE_API_KEY=
